{
  "manifest_version": 3,
  "name": "fedxss — Federated XSS Detector (research prototype)",
  "version": "0.1.0",
  "description": "Browser-side XSS detection using a model trained by federated learning. Research prototype; not for production use.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "fedxss" },
  "web_accessible_resources": [
    { "resources": ["model.json"], "matches": ["<all_urls>"] }
  ]
}
